/* ========================================
   裁剪组件样式 — 终极隔离方案
   ======================================== */

/* ---------- 全局遮罩 ---------- */
.cropper-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.85);
  z-index: 99999;
  display: flex;
  flex-direction: column;
}

.cropper-wrapper {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.cropper-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  background: #1a1a1a;
}
.toolbar-btn {
  font-size: 30rpx;
  padding: 12rpx 20rpx;
  min-width: 120rpx;
  text-align: center;
}
.toolbar-btn.cancel { color: #999; }
.toolbar-btn.confirm { color: #fff; background: #4A90D9; border-radius: 8rpx; font-weight: 600; }
.toolbar-title { color: #ccc; font-size: 28rpx; }

/* ---------- Canvas 容器 ----------
   尺寸与 Canvas CSS 尺寸一致（750rpx × 750rpx），由 flex 居中。
   作为所有裁剪元素的定位参考系（position: relative）。
   Canvas、crop-box、crop-center、handles 全部 position: absolute 相对于此。
   【关键】容器尺寸与 Canvas 一致，因此 cx/cy/cs 坐标（canvas 空间 0-375）
   直接映射到容器的 CSS 像素坐标，无需换算。 */
.cropper-canvas-area {
  flex: 0 0 auto;
  align-self: center;
  width: 750rpx;
  height: 750rpx;
  overflow: hidden;
  position: relative;
}
.cropper-canvas {
  width: 750rpx;
  height: 750rpx;
  display: block;
  position: absolute;
  left: 0;
  top: 0;
}

/* ============================================
   裁剪框边框（纯视觉，不响应触摸）
   ============================================ */
.crop-box {
  position: absolute;
  z-index: 10;
  outline: 2px solid rgba(255,255,255,0.9);
  pointer-events: none; /* 永不响应触摸 */
}

/* ============================================
   内部拖拽区（响应触摸，bindtouch*）
   ============================================ */
.crop-center {
  position: absolute;
  z-index: 10;
  pointer-events: auto;
  background: transparent;
}

/* ============================================
   统一定位控制点样式
   transform: translate(-50%, -50%) 确保控制点中心
   对齐到对应的裁剪框顶点/边中点
   ============================================ */
.handle {
  position: absolute;
  z-index: 20;
  pointer-events: auto;
  /* 中心对齐到指定的 left/top 坐标 */
  transform: translate(-50%, -50%);
}

/* 角控制点：30×30px 正方形 */
.handle-tl,
.handle-tr,
.handle-bl,
.handle-br {
  width: 30px;
  height: 30px;
  background: #ffffff;
  border: 2px solid #4A90D9;
  border-radius: 2px;
  box-shadow: 0 0 4px rgba(0,0,0,0.4);
  background-clip: content-box;
  padding: 8px;
  box-sizing: border-box;
}

/* 边中点控制点：矩形条 */
.handle-top,
.handle-bottom {
  width: 24px;
  height: 14px;
  background: #ffffff;
  border: 2px solid #4A90D9;
  border-radius: 2px;
  box-shadow: 0 0 4px rgba(0,0,0,0.4);
  background-clip: content-box;
  padding: 2px 3px;
  box-sizing: border-box;
}

.handle-left,
.handle-right {
  width: 14px;
  height: 24px;
  background: #ffffff;
  border: 2px solid #4A90D9;
  border-radius: 2px;
  box-shadow: 0 0 4px rgba(0,0,0,0.4);
  background-clip: content-box;
  padding: 3px 2px;
  box-sizing: border-box;
}
