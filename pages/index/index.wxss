/* ========================================
   pages/index/index.wxss
   黑白极简风格 (High-Contrast B&W Minimalism)
   ======================================== */

/* ===== 全局 ===== */
.scrollarea {
  height: 100vh;
  background: #FFFFFF;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0 32rpx 80rpx;
  min-height: 100vh;
  justify-content: flex-start;
  align-items: stretch;
  box-sizing: border-box;
}

/* ===== 标题区域 ===== */
.header {
  text-align: left;
  padding: 40rpx 0 30rpx;
  border-bottom: 2rpx solid #000000;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #000000;
  display: block;
  line-height: 1.2;
}

.title::after {
  content: '.';
}

.subtitle {
  font-size: 24rpx;
  font-weight: 400;
  color: #333333;
  margin-top: 12rpx;
  display: block;
  line-height: 1.5;
}

/* ===== Tab 切换栏 - 垂直全屏布局 ===== */
.tab-bar {
  display: flex;
  flex-direction: column;
  margin: 0;
  padding: 0;
  flex: 1;
  min-height: calc(100vh - 160rpx);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: #FFFFFF;
  border: none;
  border-bottom: 2rpx solid #000000;
  position: relative;
}

.tab-item:last-child {
  border-bottom: none;
}

.tab-item:active {
  background: #000000;
}

.tab-item:active .tab-title,
.tab-item:active .tab-subtitle {
  color: #FFFFFF;
}

.tab-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #000000;
}

.tab-subtitle {
  font-size: 24rpx;
  font-weight: 400;
  color: #999999;
  margin-top: 8rpx;
  text-align: center;
}

/* ===== 子页面顶部栏：返回按钮 + 页面标题 ===== */
.subpage-header {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  gap: 16rpx;
  border-bottom: 1px solid #EFEFEF;
  margin-bottom: 32rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: #FFFFFF;
  border: 1px solid #000000;
  flex-shrink: 0;
}

.back-btn:active {
  background: #000000;
}

.back-btn:active .back-icon,
.back-btn:active .back-text {
  color: #FFFFFF;
}

.back-icon {
  font-size: 40rpx;
  font-weight: 300;
  color: #000000;
  line-height: 1;
}

.back-text {
  font-size: 24rpx;
  color: #000000;
  font-weight: 500;
  text-transform: uppercase;
}

.subpage-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #000000;
  flex: 1;
}

/* ===== 社区占位 ===== */
.community-placeholder {
  background: #FFFFFF;
  border: 1px solid #000000;
  padding: 120rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.community-placeholder-text {
  font-size: 28rpx;
  color: #999999;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* ===== 区块通用 ===== */
.section-label {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #000000;
  margin-bottom: 20rpx;
  display: block;
}

/* ===== 图片上传区域 ===== */
.upload-section {
  background: #FFFFFF;
  border: 1px solid #000000;
  padding: 24rpx;
  margin-top: 32rpx;
}

/* ---- 图片来源选择（两个并排按钮） ---- */
.source-type-row {
  display: flex;
  gap: 0;
  border: 1px solid #000000;
}

.source-type-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 12rpx;
  background: #FFFFFF;
  border-right: 1px solid #000000;
}

.source-type-btn:last-child {
  border-right: none;
}

.source-type-btn:active {
  background: #000000;
}

.source-type-btn:active .source-type-text {
  color: #FFFFFF;
}

.source-type-icon {
  font-size: 48rpx;
  line-height: 1;
  font-weight: 700;
  color: #000000;
}

.source-type-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.image-preview {
  width: 100%;
  height: 360rpx;
  border: 2rpx solid #000000;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EFEFEF;
  margin-bottom: 24rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 72rpx;
  color: #999999;
  line-height: 1;
}

.upload-text {
  font-size: 28rpx;
  color: #333333;
  margin-top: 16rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.upload-hint {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

/* ===== 参数设置区域 ===== */
.params-section {
  background: #FFFFFF;
  border: 1px solid #000000;
  padding: 24rpx;
  margin-top: 32rpx;
}

.param-item {
  padding: 20rpx 0;
  border-bottom: 1px solid #EFEFEF;
}

.param-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.param-item.disabled {
  opacity: 0.4;
}

.param-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #000000;
  display: block;
  margin-bottom: 12rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* ---- 滑块范围提示小字 ---- */
.param-range {
  font-size: 20rpx;
  color: #999999;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.param-desc {
  font-size: 22rpx;
  color: #999999;
  display: block;
  margin-top: 8rpx;
}

/* ---- 推荐线宽倍率小字 ---- */
.param-recommend {
  font-size: 22rpx;
  color: #999999;
  display: block;
  margin-top: 4rpx;
}

/* ---- 模式选择（单选按钮组） ---- */
.radio-group {
  display: flex;
  gap: 0;
  border: 1px solid #000000;
}

.radio-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 0;
  background: #FFFFFF;
  border-right: 1px solid #000000;
}

.radio-item:last-child {
  border-right: none;
}

.radio-item.active {
  background: #000000;
}

.radio-item.active .radio-text {
  color: #FFFFFF;
}

.radio-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 2rpx solid #000000;
  display: inline-block;
}

.radio-dot.dot-active {
  background: #000000;
  border-color: #000000;
}

.radio-item.active .radio-dot {
  border-color: #FFFFFF;
  background: #FFFFFF;
}

.radio-text {
  font-size: 24rpx;
  color: #000000;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* ---- 开关行 ---- */
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-row .param-label {
  margin-bottom: 0;
}

/* ---- 滑块行 ---- */
.slider-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slider-row .param-label {
  margin-bottom: 0;
}

/* ---- 标签与范围提示水平排列 ---- */
.slider-label-wrapper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 70%;
  overflow: hidden;
}

.slider-label-wrapper .param-label {
  margin-bottom: 0;
  white-space: nowrap;
}

.slider-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  padding: 4rpx 12rpx;
  border: 1px solid #000000;
  min-width: 80rpx;
  text-align: center;
}

.inline-input {
  width: 120rpx;
  height: 56rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
  text-align: center;
  background: #FFFFFF;
  border: 1px solid #000000;
  padding: 0 8rpx;
}

/* ===== 操作按钮 ===== */
.action-section {
  flex-shrink: 0;
  margin-top: 32rpx;
}

.btn-hint {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  display: block;
  margin-top: 12rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.generate-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #000000;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  border: none;
  border-radius: 0;
  transition: opacity 0.2s ease;
}

.generate-btn:active {
  opacity: 0.8;
}

.generate-btn.processing {
  background: #333333;
}

.generate-btn.is-disabled {
  background: #EFEFEF;
  color: #999999;
}

/* ===== 结果展示 ===== */
.result-section {
  background: #FFFFFF;
  border: 1px solid #000000;
  padding: 24rpx;
  margin-top: 32rpx;
}

.result-box {
  width: 100%;
  max-height: 600rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 1px solid #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-canvas {
  width: 100%;
  height: 600rpx;
  display: block;
}

/* ---- 可视马赛克画布 ---- */
.mosaic-canvas {
  width: 100%;
  height: 600rpx;
  display: block;
}

/* 隐藏 Canvas */
.hidden-mosaic-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
  width: 320px;
  height: 320px;
}

/* ---- 结果操作按钮 ---- */
.result-actions {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 24rpx;
  border: 1px solid #000000;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  border: none;
  border-bottom: 1px solid #000000;
  background: #FFFFFF;
  color: #000000;
  box-sizing: border-box;
}

.action-btn:last-of-type {
  border-bottom: none;
}

.action-btn:active {
  background: #000000;
  color: #FFFFFF;
}

.share-group {
  border-bottom: 1px solid #000000;
}

.share-group .action-btn {
  border-bottom: none;
}

.share-hint {
  font-size: 20rpx;
  color: #999999;
  text-align: center;
  display: block;
  padding: 8rpx 0;
  letter-spacing: 1rpx;
}

.mosaic-coords-hint {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  margin-top: 12rpx;
  display: block;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

/* ===== 使用说明区域 ===== */
.footer {
  background: #FFFFFF;
  border: 1px solid #000000;
  padding: 24rpx;
  margin-top: 32rpx;
}

.footer-title {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #000000;
  margin-bottom: 16rpx;
  display: block;
}

.footer-text {
  font-size: 24rpx;
  font-weight: 400;
  color: #333333;
  display: block;
  line-height: 2;
}

/* ===== 蓝牙打印区域 ===== */
.ble-section {
  background: #FFFFFF;
  border: 1px solid #000000;
  padding: 24rpx;
  margin-top: 32rpx;
}

/* ---- UUID 配置 ---- */
.ble-config-toggle {
  padding: 12rpx 0;
  margin-bottom: 8rpx;
}

.ble-config-toggle-text {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.ble-config-body {
  border: 1px solid #000000;
  padding: 16rpx;
  margin-bottom: 16rpx;
  background: #FFFFFF;
}

.ble-config-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.ble-config-item:last-child {
  margin-bottom: 0;
}

.ble-config-label {
  font-size: 22rpx;
  color: #333333;
  min-width: 140rpx;
  flex-shrink: 0;
}

.ble-config-input {
  flex: 1;
  height: 56rpx;
  font-size: 20rpx;
  color: #000000;
  background: #FFFFFF;
  border: 1px solid #000000;
  padding: 0 12rpx;
}

.ble-config-confirm {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  color: #FFFFFF;
  background: #000000;
  border: none;
  margin-top: 12rpx;
}

.ble-config-confirm:active {
  opacity: 0.8;
}

/* ---- 扫描与连接行 ---- */
.ble-scan-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.ble-btn {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  border: 1px solid #000000;
  padding: 0 24rpx;
  flex-shrink: 0;
  background: #FFFFFF;
  color: #000000;
}

.ble-btn:active {
  background: #000000;
  color: #FFFFFF;
}

.scan-btn {
  background: #000000;
  color: #FFFFFF;
  min-width: 160rpx;
  border: none;
}

.scan-btn.scanning {
  background: #333333;
}

.disconnect-btn {
  background: #FFFFFF;
  color: #000000;
  border: 1px solid #000000;
}

.print-btn {
  background: #000000;
  color: #FFFFFF;
  width: 100%;
  margin-bottom: 12rpx;
  border: none;
}

.print-btn.sending {
  background: #333333;
}

.print-btn.is-disabled {
  background: #EFEFEF;
  color: #999999;
  border: none;
}

.debug-btn {
  background: #FFFFFF;
  color: #000000;
  border: 2px solid #000000;
  width: 100%;
  margin-bottom: 12rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.debug-btn:active {
  background: #000000;
  color: #FFFFFF;
}

.debug-btn.is-disabled {
  border-color: #EFEFEF;
  color: #EFEFEF;
}

/* ---- 连接状态 ---- */
.ble-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  flex: 1;
  color: #333333;
}

.ble-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
  background: #000000;
}

.ble-status.connected .ble-status-dot {
  background: #000000;
}

.ble-status.connected {
  color: #000000;
  font-weight: 600;
}

.ble-status.disconnected .ble-status-dot {
  background: #999999;
}

.ble-status.disconnected {
  color: #999999;
}

/* ---- 设备列表 ---- */
.ble-device-list {
  max-height: 400rpx;
  overflow-y: auto;
  border: 1px solid #000000;
  padding: 0;
  margin-bottom: 12rpx;
}

.ble-device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  border-bottom: 1px solid #EFEFEF;
}

.ble-device-item:last-child {
  border-bottom: none;
}

.ble-device-item:active {
  background: #000000;
}

.ble-device-item:active .ble-device-name,
.ble-device-item:active .ble-device-rssi {
  color: #FFFFFF;
}

.ble-device-name {
  font-size: 24rpx;
  color: #000000;
  font-weight: 500;
}

.ble-device-rssi {
  font-size: 20rpx;
  color: #999999;
}

/* ---- 硬件控制区域 ---- */
.ble-hw-section {
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1px solid #000000;
}

.ble-hw-section .section-label {
  margin-bottom: 12rpx;
}

.ble-hw-row {
  display: flex;
  gap: 0;
  border: 1px solid #000000;
}

.hw-on-btn {
  flex: 1;
  background: #000000;
  color: #FFFFFF;
  min-width: 0;
  border: none;
  border-right: 1px solid #FFFFFF;
}

.hw-on-btn:active {
  opacity: 0.8;
}

.hw-off-btn {
  flex: 1;
  background: #FFFFFF;
  color: #000000;
  min-width: 0;
  border: none;
}

.hw-off-btn:active {
  background: #000000;
  color: #FFFFFF;
}

.hw-on-btn.sending,
.hw-off-btn.sending {
  background: #333333;
  color: #FFFFFF;
}

.hw-on-btn.is-disabled,
.hw-off-btn.is-disabled {
  background: #EFEFEF;
  color: #999999;
}

/* ---- 打印按钮区域 ---- */
.ble-print-section {
  margin-top: 12rpx;
}

/* ---- 进度条 ---- */
.ble-progress-bar {
  width: 100%;
  height: 8rpx;
  background: #EFEFEF;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.ble-progress-fill {
  height: 100%;
  background: #000000;
  transition: width 0.3s ease;
}

.ble-progress-text {
  font-size: 22rpx;
  color: #333333;
  display: block;
  text-align: center;
  margin-bottom: 8rpx;
}

/* ---- 日志 ---- */
.ble-log {
  background: #000000;
  padding: 16rpx;
  max-height: 300rpx;
  overflow-y: auto;
  margin-top: 12rpx;
}

.ble-log-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-family: 'Courier New', Courier, monospace;
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.6;
  display: block;
}
